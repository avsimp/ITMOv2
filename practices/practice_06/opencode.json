{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru/",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-5": {
          "name": "anthropic/claude-sonnet-5"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "qwen3.5:9b"
        }
      }
    }
  },
  "agent": {
    "threat-judge": {
      "description": "Independent reviewer of the submitted threat model",
      "mode": "primary",
      "prompt": "{file:./judge-system-prompt.md}",
      "steps": 8,
      "permission": {
        "*": "deny"
      }
    },
    "shop-planner": {
      "description": "Model under test: produces a shop action without executing tools",
      "mode": "primary",
      "prompt": "{file:./planner-system.txt}",
      "permission": {
        "*": "deny"
      }
    }
  }
}
