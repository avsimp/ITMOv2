{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "enabled_providers": ["ollama"],
  "default_agent": "local-guide",
  "share": "disabled",
  "autoupdate": false,
  "mcp": {"context7": {"enabled": false}},
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO Qwen3.5 9B local 32k",
          "options": {"reasoningEffort": "none"},
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "temperature": 0.7,
      "top_p": 0.8,
      "prompt": "{file:./repo-system.txt}",
      "steps": 12,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
